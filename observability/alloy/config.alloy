logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "ezyintern" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "ezyintern_backend" {
  targets = discovery.docker.ezyintern.targets

  rule {
    source_labels = ["__meta_docker_container_label_ezyintern_logging"]
    regex         = "enabled"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    target_label = "stack"
    replacement  = "ezyintern"
  }
}

loki.source.docker "ezyintern_backend" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.ezyintern_backend.output
  labels     = {
    platform = "docker",
  }
  forward_to = [loki.process.ezyintern_pino.receiver]
}

loki.process "ezyintern_pino" {
  stage.json {
    expressions = {
      time          = "time",
      level         = "level",
      message       = "message",
      service       = "service",
      environment   = "environment",
      hostname      = "hostname",
      logType       = "logType",
      errorCategory = "errorCategory",
      requestId     = "requestId",
      traceId       = "traceId",
      method        = "method",
      path          = "path",
      route         = "route",
      status        = "status",
      durationMs    = "durationMs",
    }
    drop_malformed = true
  }

  stage.timestamp {
    source            = "time"
    format            = "RFC3339"
    action_on_failure = "skip"
  }

  stage.labels {
    values = {
      service       = "",
      environment   = "",
      hostname      = "",
      level         = "",
      logType       = "",
      errorCategory = "",
    }
  }

  stage.structured_metadata {
    values = {
      requestId  = "",
      traceId    = "",
      method     = "",
      path       = "",
      route      = "",
      status     = "",
      durationMs = "",
    }
  }

  forward_to = [loki.write.ezyintern.receiver]
}

loki.write "ezyintern" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
